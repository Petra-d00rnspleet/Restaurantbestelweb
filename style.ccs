:root{
  --coral:#FF5A4E;
  --coral-dark:#DE3E33;
  --mustard:#FFB100;
  --teal:#12706A;
  --teal-dark:#0B4F4A;
  --sage:#3FAF6D;
  --sage-dark:#2E8C55;
  --cream:#FFFBF2;
  --charcoal:#2B2420;
  --muted:#8A7F73;
  --line:#EFE3D3;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Segoe UI', 'Nunito', Arial, sans-serif;
  color:var(--charcoal);
  background:
    radial-gradient(circle at 10% 0%, #FFE9DD 0%, transparent 55%),
    radial-gradient(circle at 90% 10%, #FFF3D6 0%, transparent 50%),
    linear-gradient(160deg, #FFF8EE 0%, #FFF1E2 100%);
  min-height:100vh;
}
h1,h2,h3{font-weight:800;}
button{font-family:inherit; cursor:pointer; border:none;}
input,textarea{font-family:inherit;}
.hidden{display:none !important;}

.banner{padding:14px 16px; font-weight:800; font-size:0.9rem; text-align:center; color:white;}
.banner.warn{background:#E64545;}
.banner code{background:rgba(255,255,255,0.25); padding:2px 6px; border-radius:6px;}

.btn{font-weight:800; border-radius:14px; padding:12px 22px; font-size:0.95rem; box-shadow:0 3px 0 rgba(0,0,0,0.15); transition:transform .08s ease;}
.btn:active{transform:translateY(2px); box-shadow:0 1px 0 rgba(0,0,0,0.15);}
.btn:disabled{opacity:0.4; cursor:not-allowed; box-shadow:none;}
.btn-coral{background:var(--coral); color:white;}
.btn-teal{background:var(--teal); color:white;}
.btn-mustard{background:var(--mustard); color:var(--charcoal);}
.btn-sage{background:var(--sage); color:white;}
.btn-outline{background:white; color:var(--charcoal); border:2px solid var(--line);}
.btn-danger{background:#E64545; color:white;}
.btn-sm{padding:7px 14px; font-size:0.8rem; border-radius:10px;}

input[type=text], textarea{border:2px solid var(--line); border-radius:12px; padding:12px 14px; font-size:1rem; width:100%; background:white;}
input[type=text]:focus, textarea:focus{outline:none; border-color:var(--coral);}
label.checkbox{display:flex; align-items:center; gap:8px; font-weight:700; cursor:pointer;}

.centered-screen{min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;}
.card{background:var(--cream); border-radius:22px; padding:36px; max-width:440px; width:100%; box-shadow:0 10px 0 rgba(0,0,0,0.08); text-align:center;}
.card .emoji-big{font-size:3.4rem;}
.card h1{margin:6px 0 4px; font-size:1.8rem; color:var(--coral-dark);}
.card p.sub{color:var(--muted); font-weight:700; margin:0 0 24px;}
.card .stack{display:flex; flex-direction:column; gap:12px;}
.card .field{text-align:left; margin-bottom:16px;}
.card .field label{display:block; font-weight:800; margin-bottom:6px; font-size:0.85rem; color:var(--teal-dark);}
.back-link{background:none; color:var(--muted); font-weight:700; margin-top:14px; font-size:0.85rem; text-decoration:underline;}
.error-msg{color:var(--coral-dark); font-weight:800; font-size:0.85rem; margin-top:8px; min-height:1.2em;}

.app-shell{min-height:100vh; padding-bottom:60px;}
.topbar{background:var(--teal); color:white; padding:16px 20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;}
.topbar .brand{display:flex; align-items:center; gap:10px;}
.topbar .brand h1{margin:0; font-size:1.3rem; color:white;}
.topbar .brand .code-chip{background:rgba(255,255,255,0.15); padding:4px 10px; border-radius:999px; font-size:0.75rem; font-weight:800; letter-spacing:1px;}
.topbar .leave-btn{background:rgba(255,255,255,0.15); color:white;}

.tabbar{display:flex; gap:6px; padding:10px 16px; overflow-x:auto; background:var(--teal-dark);}
.tab-btn{background:transparent; color:rgba(255,255,255,0.65); font-weight:800; padding:10px 16px; border-radius:12px; white-space:nowrap; font-size:0.9rem;}
.tab-btn.active{background:var(--cream); color:var(--teal-dark);}

.view-panel{max-width:1100px; margin:0 auto; padding:20px 16px;}

.order-layout{display:grid; grid-template-columns:1fr 340px; gap:18px;}
@media (max-width:820px){.order-layout{grid-template-columns:1fr;}}
.product-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(120px,1fr)); gap:12px;}
.product-card{background:var(--cream); border-radius:16px; padding:16px 8px; text-align:center; box-shadow:0 3px 0 rgba(0,0,0,0.08); border:2px solid transparent;}
.product-card .emoji{font-size:2.1rem;}
.product-card .name{font-weight:800; font-size:0.85rem; margin-top:4px;}
.product-card:hover{border-color:var(--coral);}

.cart-panel{background:var(--cream); border-radius:18px; padding:16px; box-shadow:0 3px 0 rgba(0,0,0,0.08); align-self:start; position:sticky; top:16px;}
.cart-panel h3{margin:0 0 10px; color:var(--teal-dark);}
.cart-item{display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 0; border-bottom:1px dashed var(--line); font-size:0.85rem;}
.cart-item .left{display:flex; align-items:center; gap:8px; font-weight:700;}
.cart-item .qty-ctrl{display:flex; align-items:center; gap:6px;}
.cart-item .qty-ctrl button{background:var(--line); width:22px; height:22px; border-radius:6px; font-weight:800;}
.cart-empty{color:var(--muted); font-size:0.85rem; text-align:center; padding:14px 0;}

.kanban{display:grid; grid-template-columns:repeat(2, 1fr); gap:14px;}
@media (max-width:820px){.kanban{grid-template-columns:1fr;}}
.kanban-col{background:rgba(255,255,255,0.5); border-radius:16px; padding:12px; min-height:120px;}
.kanban-col h3{margin:0 0 10px; font-size:0.95rem; display:flex; align-items:center; justify-content:space-between;}
.kanban-col .count{background:var(--coral); color:white; font-size:0.7rem; padding:2px 9px; border-radius:999px;}

.ticket{background:var(--cream); border-radius:4px 4px 12px 12px; padding:14px; margin-bottom:12px; box-shadow:0 3px 0 rgba(0,0,0,0.08); border-top:6px dashed var(--mustard); font-size:0.85rem;}
.ticket .time{color:var(--muted); font-weight:700; font-size:0.72rem; margin-bottom:6px;}
.ticket .item-line{display:flex; justify-content:space-between; gap:6px; padding:3px 0;}
.ticket .item-line .qty{font-weight:900; color:var(--coral-dark); margin-right:4px;}
.ticket .note{margin-top:8px; padding:8px; background:#FFF3D6; border-radius:8px; font-style:italic; font-size:0.8rem;}
.ticket .ticket-actions{margin-top:10px; display:flex; gap:8px;}
.empty-col-msg{color:var(--muted); font-size:0.8rem; text-align:center; padding:16px 4px;}

.bezorgen-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:14px;}

.settings-grid{display:grid; grid-template-columns:1fr 1fr; gap:18px;}
@media (max-width:820px){.settings-grid{grid-template-columns:1fr;}}
.panel-box{background:var(--cream); border-radius:18px; padding:18px; box-shadow:0 3px 0 rgba(0,0,0,0.08);}
.panel-box h3{margin:0 0 12px; color:var(--teal-dark);}
.code-display{display:flex; align-items:center; gap:10px; background:white; border:2px dashed var(--coral); border-radius:12px; padding:14px; font-size:1.5rem; font-weight:900; letter-spacing:3px; color:var(--coral-dark); justify-content:center;}
.emoji-picker{display:flex; flex-wrap:wrap; gap:6px; margin:8px 0 14px;}
.emoji-picker button{background:white; border:2px solid var(--line); border-radius:10px; font-size:1.2rem; padding:6px 8px;}
.emoji-picker button.selected{border-color:var(--coral); background:#FFEDE9;}
.product-manage-row{display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 0; border-bottom:1px solid var(--line); font-size:0.85rem;}
.product-manage-row .left{display:flex; align-items:center; gap:8px; font-weight:700;}

.toast{position:fixed; bottom:20px; left:50%; transform:translateX(-50%); background:var(--charcoal); color:white; padding:11px 20px; border-radius:12px; font-weight:700; font-size:0.9rem; z-index:80; opacity:0; transition:opacity .25s ease; pointer-events:none;}
.toast.show{opacity:1;}

.section-title{color:var(--teal-dark); margin:0 0 14px;}
.muted{color:var(--muted); font-weight:600;}
